direction: down
need: "🎯 NEED / GOAL\nConcrete and executable"
wish: "✨ WISH\nWhy 1"
dream: "🌠 DREAM\nWhy 2"
fantasy: "🌌 FANTASY\nWhy 3"
need -> wish: "WHY?"
wish -> dream: "WHY?"
dream -> fantasy: "WHY?"
need.style: { fill: "#10231f"; stroke: "#5eead4"; stroke-width: 2; shadow: true; border-radius: 18 }
wish.style: { fill: "#101827"; stroke: "#38bdf8"; stroke-width: 2; shadow: true; border-radius: 18 }
dream.style: { fill: "#211a35"; stroke: "#c084fc"; stroke-width: 2; shadow: true; border-radius: 18 }
fantasy.style: { fill: "#2a220f"; stroke: "#fbbf24"; stroke-width: 2; shadow: true; border-radius: 18 }
